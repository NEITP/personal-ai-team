
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task_spec.schema.json",
  "title": "Personal AI Team Task Specification",
  "description": "Standard contract for assigning tasks to AI agents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "assigned_to",
    "task_type",
    "objective",
    "context",
    "constraints",
    "acceptance_criteria",
    "output_format"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{3,}$"
    },
    "assigned_to": {
      "type": "string",
      "enum": ["codex", "antigravity", "ollama"]
    },
    "task_type": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "files"],
      "properties": {
        "summary": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "output_format": {
      "type": "string",
      "enum": ["markdown", "json"]
    }
  }
}
